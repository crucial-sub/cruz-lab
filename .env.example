# ==============================================
# 클라이언트: Firebase 웹 앱 설정 (공개 값)
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > 웹 앱의 SDK 설정에서 복사한다.
# ==============================================
PUBLIC_FIREBASE_API_KEY=AIza...your-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ==============================================
# 서버: Firebase Admin SDK (비공개)
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 → JSON의 값을 넣는다.
# - FIREBASE_ADMIN_PROJECT_ID가 비면 PUBLIC_FIREBASE_PROJECT_ID를 쓴다.
# - FIREBASE_ADMIN_PRIVATE_KEY는 줄바꿈을 \n으로 넣어도 된다. 따옴표로 감싼다.
# ==============================================
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==============================================
# 서버: 관리자 (비공개)
# 관리자 Google 계정의 Firebase Auth UID. Firebase Console > Authentication > 사용자에서 확인한다.
# 없으면 관리자 API가 503(ADMIN_NOT_CONFIGURED)을 돌려준다.
# ==============================================
ADMIN_UID=your-admin-uid

# ==============================================
# 서버: 백업 알림 (비공개, 선택)
# 발행·삭제 직후 백업 저장소에 repository_dispatch를 보내는 GitHub 토큰.
# 백업 저장소 이름은 src/lib/server/backup-dispatch.ts의 BACKUP_REPOSITORY에 있다.
# 백업 저장소 하나에 Contents 읽기·쓰기 권한만 준 fine-grained PAT를 쓴다.
# 없으면 알림을 건너뛴다(로컬 기본). 백업은 매일 예약 실행으로도 돈다.
# ==============================================
BACKUP_DISPATCH_TOKEN=

# ==============================================
# 처음 설정할 때 (Firebase Console)
# 1. 새 프로젝트를 만든다.
# 2. Authentication > Sign-in method > Google을 켠다.
# 3. Authentication > 설정 > 승인된 도메인에 사이트 주소를 더한다(localhost는 기본으로 있다).
# 4. Firestore Database와 Storage를 만든다.
# 5. 프로젝트 설정 > 일반 > 내 앱 > 웹 앱을 더하고 위 PUBLIC_ 값을 복사한다.
# ==============================================
