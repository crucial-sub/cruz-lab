---
// 고치기 화면 (서가 2단계 T6, Plan J36, L9 글자 칸)
// 위에서 아래 순서:
// 1. 머리줄: "← 문서", 문서 제목, 취소·저장
// 2. 되돌릴 원본 한 줄: 맥 원본 경로와 "lab pull로 원본에 씁니다", 또는 "서가 화면으로 올린 문서라 되돌릴 원본이 없습니다"
// 3. 임시 글 안내(숨김): 같은 판의 임시 글을 불러왔을 때, 앞 판에서 고치던 글이 있을 때 (edit-view.ts)
// 4. 상태 줄: 저장 중·실패·409 안내. 글자 칸 위에 둔다(아이폰 자판이 올라와도 저장 단추 가까이 보인다)
// 5. 글자 칸: md 원문 그대로. 고정폭 글꼴 16px(아이폰이 확대하지 않는 크기). 한국어 입력·자동 고침은 기기 기본 그대로다
import type { FormatState, LibraryDoc } from '../server/store';
import { textareaContent, usesCrlf } from './edit-view';

interface Props {
  docId: string;
  doc: LibraryDoc;
  md: FormatState;
  text: string;
}

const { docId, doc, md, text } = Astro.props;
const viewUrl = `/admin/library/d/${docId}`;
const pending = (doc.mdSync?.pendingRev ?? null) !== null;
const headerButton = 'rounded-md px-3 py-1 text-sm';
const noticeButton = 'rounded-md border border-border px-2 py-0.5 text-xs text-text-primary hover:bg-bg-card';
---

<header
  class="sticky top-0 z-20 flex h-12 items-center gap-2 border-b border-border bg-bg-surface px-3 pt-[env(safe-area-inset-top)]"
>
  <a
    href={viewUrl}
    class="shrink-0 rounded-md px-2 py-1 text-sm text-text-secondary hover:bg-bg-card hover:text-text-primary"
  >
    ← 문서
  </a>
  <p class="min-w-0 truncate text-sm font-medium">{doc.title}</p>
  <div class="ml-auto flex shrink-0 items-center gap-1">
    <button type="button" data-edit-cancel class={`${headerButton} text-text-secondary hover:bg-bg-card hover:text-text-primary`}>
      취소
    </button>
    <button
      type="button"
      data-edit-save
      class={`${headerButton} bg-brand font-medium text-white hover:bg-brand-hover disabled:opacity-60`}
    >
      저장
    </button>
  </div>
</header>

<main
  class="mx-auto flex max-w-3xl flex-col gap-2 px-3 pb-6 pt-3"
  data-edit-view
  data-doc-id={docId}
  data-base-rev={md.rev}
  data-crlf={usesCrlf(text) ? '1' : '0'}
>
  <p class="break-words text-xs text-text-secondary">
    {
      doc.sourcePath ? (
        <>
          맥 원본 <code class="break-all text-text-primary">{doc.sourcePath}</code>. 저장하면 폰 판이 됩니다. 맥에서{' '}
          <code class="text-text-primary">lab pull</code>로 원본에 씁니다.
          {pending && ' 아직 맥에 되돌리지 않은 폰 판이 있습니다.'}
        </>
      ) : (
        '서가 화면으로 올린 문서라 되돌릴 원본이 없습니다. 저장한 글은 서가에만 있습니다.'
      )
    }
  </p>
  <p data-edit-draft hidden class="edit-notice">
    이 기기에 임시 저장한 글을 불러왔습니다.
    <button type="button" data-edit-draft-discard class={noticeButton}>버리기</button>
  </p>
  <p data-edit-older hidden class="edit-notice">
    앞 판에서 고치던 글이 이 기기에 남아 있습니다.
    <button type="button" data-edit-older-copy class={noticeButton}>그 글 복사</button>
    <button type="button" data-edit-older-discard class={noticeButton}>버리기</button>
  </p>
  <p data-edit-status role="status" aria-live="polite" class="edit-status break-words text-sm"></p>
  <textarea data-edit-text aria-label="md 원문" class="edit-text">{textareaContent(text)}</textarea>
</main>

<script>
  import { setupEditView } from './edit-view';
  setupEditView();
</script>

<style>
  .edit-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.375rem 0.625rem;
    background: var(--bg-card);
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }
  .edit-notice[hidden] {
    display: none;
  }
  /* 글자 칸: 고정폭 16px. 화면 높이를 채운다(머리줄·안내 줄 몫을 뺀다) */
  .edit-text {
    width: 100%;
    min-height: 16rem;
    height: calc(100dvh - 10rem);
    resize: vertical;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.75rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.6;
    tab-size: 4;
    overflow-wrap: anywhere;
  }
  .edit-text:focus {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }
  .edit-status:empty {
    display: none;
  }
  .edit-status[data-tone='error'] {
    color: #dc2626;
  }
</style>
