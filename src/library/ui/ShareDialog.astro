---
// 공유 창 (서가 2단계 T9, Plan J51)
// - 서가 목록과 md 뷰어가 넣는다. 공유 스위치가 꺼져 있으면 페이지가 넣지 않는다(J50).
// - 동작은 share-dialog.ts가 한다. 사용자 값은 textContent·value로만 넣는다.
// - 기간 글은 share.ts의 SHARE_DURATION_LABELS를 쓴다(기본 7일).
import { DEFAULT_SHARE_DURATION, SHARE_DURATION_LABELS, SHARE_DURATIONS, type ShareDuration } from '../share';

const durations = Object.keys(SHARE_DURATIONS) as ShareDuration[];
const button = 'rounded-md border border-border px-3 py-1.5 text-sm hover:bg-bg-card';
const primary = 'rounded-md bg-brand px-3 py-1.5 text-sm text-white hover:bg-brand-hover disabled:opacity-60';
---

<dialog
  id="share-dialog"
  aria-labelledby="share-title"
  class="w-[min(24rem,calc(100vw-2rem))] rounded-lg border border-border bg-bg-surface p-4 text-text-primary shadow-popover backdrop:bg-black/50"
>
  <h2 id="share-title" class="font-semibold">링크 공유</h2>
  <p data-share-target class="mt-1 line-clamp-2 break-words text-sm text-text-secondary"></p>

  <div data-share-form class="mt-3 flex flex-col gap-3">
    <label data-share-scope-row hidden class="flex flex-col gap-1 text-sm">
      <span class="text-xs text-text-secondary">범위</span>
      <select
        data-share-scope
        class="w-full rounded-md border border-border bg-bg-app px-2.5 py-1.5 text-base text-text-primary"
      ></select>
    </label>
    <fieldset class="flex flex-col gap-1">
      <legend class="mb-1 text-xs text-text-secondary">기간</legend>
      <div class="flex flex-wrap gap-2">
        {
          durations.map((duration) => (
            <label class="flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-sm has-[:checked]:border-brand has-[:checked]:text-brand">
              <input type="radio" name="share-duration" value={duration} checked={duration === DEFAULT_SHARE_DURATION} />
              {SHARE_DURATION_LABELS[duration]}
            </label>
          ))
        }
      </div>
    </fieldset>
    <p class="text-xs text-text-secondary">
      주소를 아는 사람은 로그인 없이 읽습니다. 검색 엔진에는 실리지 않습니다. 묶음(프로젝트·폴더)은 나중에 올린 문서도
      보입니다.
    </p>
    <p data-share-error role="alert" hidden class="text-sm text-red-500"></p>
    <div class="flex justify-end gap-2">
      <button type="button" data-share-action="cancel" class={button}>취소</button>
      <button type="button" data-share-action="create" data-share-submit class={primary}>공유 주소 만들기</button>
    </div>
  </div>

  <div data-share-result hidden class="mt-3 flex flex-col gap-3">
    <p data-share-summary class="break-words text-sm text-brand"></p>
    <img data-share-qr alt="공유 주소 QR 코드" width="192" height="192" class="mx-auto block size-48 rounded-md bg-white" />
    <label class="flex flex-col gap-1">
      <span class="text-xs text-text-secondary">공유 주소</span>
      <input
        data-share-url
        readonly
        class="w-full rounded-md border border-border bg-bg-app px-2.5 py-1.5 text-xs text-text-primary"
      />
    </label>
    <div class="flex justify-end gap-2">
      <button type="button" data-share-action="copy" class={button}>주소 복사</button>
      <button type="button" data-share-action="close" class={primary}>닫기</button>
    </div>
  </div>
</dialog>
