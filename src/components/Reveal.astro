---
// 스크롤 진입 시 페이드인 (React 없이 동작)
// - 예전 FadeInSection은 섹션마다 React 아일랜드였다. 홈에서만 6개가 따로 하이드레이션되었다.
// - 이 컴포넌트는 CSS 트랜지션 + IntersectionObserver 하나로 같은 효과를 낸다.
// - 움직이는 속성은 opacity, transform뿐이라 GPU 합성 단계에서 처리된다.
interface Props {
  delay?: number; // 초 단위 지연
  class?: string;
}

const { delay = 0, class: className = '' } = Astro.props;
---

<div class:list={['reveal', className]} style={`--reveal-delay:${delay}s`} data-reveal>
  <slot />
</div>

<style>
  .reveal {
    /* 화면 밖 섹션은 첫 렌더링에서 레이아웃·Paint를 건너뛴다.
       첫 진입 때 긴 페이지 전체를 한 번에 그리느라 프레임이 끊기던 문제를 줄인다.
       auto 600px: 아직 안 그린 섹션의 높이를 600px로 잡고, 한 번 그린 뒤에는 실제 높이를 기억한다. */
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
    opacity: 0;
    transform: translate3d(0, 40px, 0);
    transition:
      opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) var(--reveal-delay, 0s),
      transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) var(--reveal-delay, 0s);
  }
  .reveal.is-revealed {
    opacity: 1;
    transform: none;
  }
  /* 움직임 줄이기 설정이면 바로 보이게 한다 */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // 관찰 시작
  // - 스크립트가 실행되는 즉시 한 번 실행한다. astro:page-load만 기다리면 하이드레이션이 끝난 뒤에야
  //   이벤트가 와서 첫 화면 섹션이 3초 넘게 안 보였다.
  // - 페이지 전환(ClientRouter) 뒤에도 다시 실행한다. 이미 관찰 중인 요소는 건너뛴다.
  function observeReveals() {
    const targets = document.querySelectorAll<HTMLElement>(
      '[data-reveal]:not(.is-revealed):not([data-reveal-observed])'
    );
    if (targets.length === 0) return;

    // IntersectionObserver가 없는 환경이면 모두 바로 보이게 한다
    if (!('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-revealed'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -50px 0px' }
    );
    targets.forEach((el) => {
      el.setAttribute('data-reveal-observed', '');
      observer.observe(el);
    });
  }

  observeReveals();
  document.addEventListener('astro:page-load', observeReveals);
</script>
