---
// 목록 필터 검색창 (재건 4단계 D2)
// - 서버가 모든 행을 그린다. 이 스크립트는 맞지 않는 행을 숨긴다(제목·설명·태그·카테고리 이름).
// - 결과 수를 고친다. 묶음(연도)의 행이 모두 숨으면 묶음 머리도 숨긴다. 0이면 "결과 없음"을 보인다.
// - 주소의 ?q=를 처음에 읽는다. 입력하면 ?q=를 고친다(history.replaceState. 새 방문 기록은 만들지 않는다).
// - JS가 없으면 검색창을 숨긴다(data-js-only). 목록은 모두 보인다.
// - 같은 페이지의 [data-post-list] 하나를 대상으로 한다.
interface Props {
  total: number;
}

const { total } = Astro.props;
---

<div class="search-filter" data-js-only>
  <label class="sr-only" for="post-search">글 검색</label>
  <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path
      d="m20 20-3.5-3.5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
  <input
    id="post-search"
    type="search"
    name="q"
    placeholder="제목·설명·태그로 찾기"
    autocomplete="off"
    spellcheck="false"
    data-post-search
    data-total={total}
  />
</div>

<script>
  import { matchesSearch } from '@/lib/search-filter';

  const input = document.querySelector<HTMLInputElement>('[data-post-search]');
  const list = document.querySelector<HTMLElement>('[data-post-list]');
  const countEl = document.querySelector<HTMLElement>('[data-result-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-result-empty]');

  if (input && list) {
    const rows = [...list.querySelectorAll<HTMLElement>('[data-post-row]')];
    const groups = [...list.querySelectorAll<HTMLElement>('[data-year-group]')];
    const total = Number(input.dataset.total ?? rows.length);

    // 검색어로 행을 거르고 결과 수·묶음 머리·빈 결과 안내를 맞춘다
    const apply = (query: string) => {
      let visible = 0;
      for (const row of rows) {
        const match = matchesSearch(row.dataset.search ?? '', query);
        row.hidden = !match;
        if (match) visible += 1;
      }
      for (const group of groups) {
        group.hidden = !group.querySelector('[data-post-row]:not([hidden])');
      }
      const filtering = query.trim().length > 0;
      if (countEl)
        countEl.textContent = filtering ? `${visible}편 / 전체 ${total}편` : `${total}편`;
      if (emptyEl) emptyEl.hidden = visible > 0;
    };

    // 주소의 ?q=를 고친다 (다른 검색 매개변수는 지킨다)
    const syncUrl = (query: string) => {
      const url = new URL(window.location.href);
      if (query.trim()) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      history.replaceState(history.state, '', url);
    };

    const initial = new URL(window.location.href).searchParams.get('q') ?? '';
    if (initial) {
      input.value = initial;
      apply(initial);
    }
    input.addEventListener('input', () => {
      apply(input.value);
      syncUrl(input.value);
    });
  }
</script>

<style>
  .search-filter {
    position: relative;
    flex: 1 1 14rem;
    max-width: 22rem;
  }
  .search-icon {
    position: absolute;
    top: 50%;
    left: 0.75rem;
    color: var(--text-secondary);
    transform: translateY(-50%);
    pointer-events: none;
  }
  input {
    width: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--text-primary);
    font: inherit;
    font-size: var(--text-sm);
    transition: var(--transition-colors);
  }
  input::placeholder {
    color: var(--text-secondary);
  }
  input:focus-visible {
    border-color: var(--brand);
    outline: none;
  }
</style>
