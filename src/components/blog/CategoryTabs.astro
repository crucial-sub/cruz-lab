---
// 카테고리 탭 (재건 4단계 D11·D17)
// - 전체 + 발행 글이 있는 카테고리. 글 수를 함께 보인다. 좁은 화면에서는 가로로 스크롤한다.
// - 탭은 링크다. 누르면 주소가 바뀐다(/blog, /blog/category/<key>). 현재 탭은 aria-current="page".
// - 태그 페이지에서는 어느 탭도 현재가 아니다(current = null).
import type { CategoryTab } from '@/lib/blog-list';
import { BLOG_INDEX_PATH } from '@/lib/public-paths';

interface Props {
  tabs: CategoryTab[];
  total: number;
  current: string | 'all' | null;
}

const { tabs, total, current } = Astro.props;
const items = [{ key: 'all', label: '전체', count: total, href: BLOG_INDEX_PATH }, ...tabs];
---

<nav class="category-tabs" aria-label="카테고리">
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
            {item.label}
            <span class="category-count">{item.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .category-tabs {
    margin-inline: calc(var(--gutter) * -1);
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--border);
  }
  .category-tabs::-webkit-scrollbar {
    display: none;
  }
  ul {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.625rem 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-colors);
  }
  a:hover {
    color: var(--text-primary);
  }
  a[aria-current='page'] {
    border-bottom-color: var(--brand);
    color: var(--text-primary);
    font-weight: 700;
  }
  .category-count {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
</style>
