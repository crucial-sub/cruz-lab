---
// 글 목록 한 행 (재건 4단계 D17, U10)
// - 날짜(MM.DD) · 제목 · 설명 1줄(640px 미만 숨김) · 연재 배지 · 읽기 시간. 커버는 없다.
// - 행 전체를 누를 수 있다. 링크는 제목 하나이고, 가상 요소로 행 전체를 덮는다(링크 이름 = 제목).
// - 연재 배지("Pintos 2/5")는 표시일 뿐 링크가 아니다(행 링크 안의 링크를 만들지 않는다, D6 답).
// - data-search: 목록 필터(SearchFilter)가 비교하는 글자(제목·설명·태그·카테고리 이름, D2).
import { searchTextFor, type ListPost, type SeriesBadge } from '@/lib/blog-list';
import { formatSeoulMonthDay } from '@/lib/date-format';
import { blogPath } from '@/lib/slug-lookup';

interface Props {
  post: ListPost;
  badge?: SeriesBadge;
}

const { post, badge } = Astro.props;
---

<li class="post-row" data-post-row data-search={searchTextFor(post)}>
  <time class="post-row-date" datetime={post.pubDate.toISOString()}
    >{formatSeoulMonthDay(post.pubDate)}</time
  >
  <div class="post-row-main">
    <h3 class="post-row-title">
      <a href={blogPath(post.slug)}>{post.title}</a>
    </h3>
    {post.description && <p class="post-row-desc">{post.description}</p>}
  </div>
  <p class="post-row-meta">
    {
      badge && (
        <span class="post-row-series">
          {badge.title} {badge.position}/{badge.total}
        </span>
      )
    }
    <span class="post-row-time">{post.readingTime}분</span>
  </p>
</li>

<style>
  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 0.75rem;
    padding: 0.875rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: var(--transition-colors);
  }
  /* 검색 필터가 숨긴 행 (display: grid가 hidden 속성을 이기지 않게) */
  .post-row[hidden] {
    display: none;
  }
  .post-row:hover {
    background: var(--bg-surface);
  }
  .post-row-date {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .post-row-main {
    min-width: 0;
  }
  .post-row-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.45;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .post-row-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .post-row-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-row-title a:focus-visible {
    outline: none;
  }
  /* 포커스 표시는 전체를 덮는 가상 요소에 그린다(:has()가 없는 브라우저에서도 보인다) */
  .post-row-title a:focus-visible::after {
    outline: 2px solid var(--ring-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .post-row:hover .post-row-title a {
    color: var(--brand);
  }
  .post-row-desc {
    margin: 0.125rem 0 0;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .post-row-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 0.5rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    white-space: nowrap;
  }
  .post-row-series {
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
  }

  /* 640px 미만: 설명을 숨기고, 연재 배지·읽기 시간을 제목 아래로 내린다 */
  @media (max-width: 639.98px) {
    .post-row {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .post-row-desc {
      display: none;
    }
    .post-row-meta {
      grid-column: 2;
      justify-content: flex-start;
      margin-top: 0.25rem;
    }
  }
</style>
