---
// 글 목록 한 행 (재건 4단계 D19 매거진형. D17의 커버 없는 행을 바꿨다)
// - 작은 코드 커버(128×72, 640px 미만은 80×80) · 카테고리 · 날짜 · 제목 19px · 설명 2줄 · 연재 배지 · 읽기 시간.
// - 행 전체를 누를 수 있다. 링크는 제목 하나이고, 가상 요소로 행 전체를 덮는다(링크 이름 = 제목, 5절 33).
// - 연재 배지("Pintos 2/5")는 표시일 뿐 링크가 아니다(행 링크 안의 링크를 만들지 않는다, D6 답).
// - data-post-row: 검색 필터(SearchFilter)와 스모크(행 수 세기)가 센다. 대표 카드(FeaturedPost)도 같은 속성이다.
// - data-search: 목록 필터가 비교하는 글자(제목·설명·태그·카테고리 이름, D2).
import { searchTextFor, type ListPost, type SeriesBadge } from '@/lib/blog-list';
import { formatSeoulDate } from '@/lib/date-format';
import { blogPath } from '@/lib/slug-lookup';
import PostCover from './PostCover.astro';

interface Props {
  post: ListPost;
  badge?: SeriesBadge;
}

const { post, badge } = Astro.props;
---

<li class="post-row" data-post-row data-search={searchTextFor(post)}>
  <div class="post-row-cover">
    <PostCover
      categoryLabel={post.categoryLabel}
      tags={post.tags}
      slug={post.slug}
      date={post.pubDate}
      variant="thumb"
    />
  </div>
  <div class="post-row-main">
    <p class="post-row-meta">
      {post.categoryLabel && <span>{post.categoryLabel}</span>}
      <time datetime={post.pubDate.toISOString()}>{formatSeoulDate(post.pubDate)}</time>
    </p>
    <h3 class="post-row-title">
      <a href={blogPath(post.slug)}>{post.title}</a>
    </h3>
    {post.description && <p class="post-row-desc">{post.description}</p>}
    <p class="post-row-foot">
      {
        badge && (
          <span class="post-row-series">
            {badge.title} {badge.position}/{badge.total}
          </span>
        )
      }
      <span class="post-row-time">{post.readingTime}분</span>
    </p>
  </div>
</li>

<style is:global>
  /* 전역 스타일(is:global): 행 54개의 data-astro-cid 속성을 없애 /blog HTML을 줄인다(D19). 클래스 이름은 post-row-* 로만 쓴다 */
  /* 행마다 윗선. 연도 머리에는 선이 없어, 검색으로 앞 행이 숨어도 선이 겹치지 않는다(리뷰 중요 3) */
  .post-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 0.5rem;
    border-top: 1px solid var(--border);
    transition: var(--transition-colors);
  }
  /* 검색 필터가 숨긴 행 (display: flex가 hidden 속성을 이기지 않게) */
  .post-row[hidden] {
    display: none;
  }
  .post-row:hover {
    background: var(--bg-surface);
  }
  .post-row-cover {
    flex: 0 0 auto;
    width: 128px;
    height: 72px;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  .post-row-main {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .post-row-meta {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .post-row-meta span:not(:last-child)::after {
    content: '·';
    margin-left: 0.5rem;
  }
  .post-row-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .post-row-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  /* 행 전체를 덮는 누를 자리 */
  .post-row-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-row-title a:focus-visible {
    outline: none;
  }
  /* 포커스 표시는 전체를 덮는 가상 요소에 그린다(:has()가 없는 브라우저에서도 보인다) */
  .post-row-title a:focus-visible::after {
    outline: 2px solid var(--ring-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .post-row:hover .post-row-title a {
    color: var(--brand);
  }
  .post-row-desc {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .post-row-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0.125rem 0 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    line-height: 1.5;
    white-space: nowrap;
  }
  .post-row-series {
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
  }

  /* 640px 미만: 커버는 80×80, 제목은 본문 크기 */
  @media (max-width: 639.98px) {
    .post-row {
      gap: 0.875rem;
      padding: 0.875rem 0.25rem;
    }
    .post-row-cover {
      width: 80px;
      height: 80px;
    }
    .post-row-title {
      font-size: var(--text-base);
    }
  }
</style>
