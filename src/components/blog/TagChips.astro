---
// 태그 칩 (재건 4단계 D17, U9)
// - 발행 글에 쓰인 태그. 글 수 많은 순. 줄바꿈을 허용한다.
// - 칩은 /blog/tag/<tag> 링크다. 태그 페이지에서는 그 태그가 현재(aria-current="page")다.
// - 연재 3개는 같은 이름의 태그가 있어 연재 입구 중 하나다(D6 답 2).
import type { TagChip } from '@/lib/blog-list';

interface Props {
  chips: TagChip[];
  current?: string | null;
}

const { chips, current = null } = Astro.props;
---

{
  chips.length > 0 && (
    <ul class="tag-chips" aria-label="태그">
      {chips.map((chip) => (
        <li>
          <a href={chip.href} aria-current={chip.tag === current ? 'page' : undefined}>
            #{chip.tag}
            <span class="tag-count">{chip.count}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-decoration: none;
    transition: var(--transition-colors);
  }
  a:hover {
    border-color: var(--brand);
    color: var(--text-primary);
  }
  a[aria-current='page'] {
    border-color: var(--brand);
    background: var(--brand-tint);
    color: var(--text-primary);
    font-weight: 600;
  }
  .tag-count {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
</style>
