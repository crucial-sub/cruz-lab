---
// 커버가 있는 글 카드 (재건 4단계 D9·D17)
// - 홈의 최신 글 3편에 쓴다. 목록(/blog)은 대표 카드(FeaturedPost) + 작은 커버 행(PostRow)이다(D19).
// - 카드 전체를 누를 수 있다. 링크는 제목 하나이고, 가상 요소로 카드 전체를 덮는다(링크 이름 = 제목).
// - hover 때 테두리 색만 바뀐다(6.3).
import type { ListPost } from '@/lib/blog-list';
import { formatSeoulDate } from '@/lib/date-format';
import { blogPath } from '@/lib/slug-lookup';
import PostCover from './PostCover.astro';

interface Props {
  post: ListPost;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="post-card">
  <div class="post-card-cover">
    <PostCover
      categoryLabel={post.categoryLabel}
      category={post.category}
      tags={post.tags}
      slug={post.slug}
      date={post.pubDate}
    />
  </div>
  <div class="post-card-body">
    <p class="post-card-meta">
      {post.categoryLabel && <span>{post.categoryLabel}</span>}
      <time datetime={post.pubDate.toISOString()}>{formatSeoulDate(post.pubDate)}</time>
    </p>
    <Heading class="post-card-title">
      <a href={blogPath(post.slug)}>{post.title}</a>
    </Heading>
    {post.description && <p class="post-card-desc">{post.description}</p>}
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    transition: var(--transition-colors);
  }
  .post-card:hover,
  .post-card:focus-within {
    border-color: var(--brand);
  }
  .post-card-cover {
    aspect-ratio: 16 / 9;
  }
  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.125rem 1.25rem;
  }
  .post-card-meta {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
  .post-card-meta span:not(:last-child)::after {
    content: '·';
    margin-left: 0.5rem;
  }
  .post-card-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--leading-heading);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .post-card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  /* 카드 전체를 덮는 누를 자리 */
  .post-card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-card-title a:focus-visible {
    outline: none;
  }
  /* 포커스 표시는 전체를 덮는 가상 요소에 그린다(:has()가 없는 브라우저에서도 보인다).
     카드는 overflow: hidden이라 안쪽(-2px)에 그린다 */
  .post-card-title a:focus-visible::after {
    outline: 2px solid var(--ring-focus);
    outline-offset: -2px;
    border-radius: var(--radius-lg);
  }
  .post-card-desc {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>
