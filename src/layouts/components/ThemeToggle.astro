---
// 테마 전환 버튼 (재건 4단계 D9)
// - 3단계까지는 React 아일랜드(client:load)였다. 지금은 버튼 하나와 작은 클라이언트 스크립트다.
// - 처음 테마는 BaseHead의 인라인 스크립트가 정한다(저장값 → 시스템 설정). 이 스크립트는 누를 때만 바꾼다.
// - 아이콘은 CSS가 html.light/.dark에 맞춰 고른다. 그래서 그려진 뒤 깜박이지 않는다.
// - JS가 없으면 바꿀 수 없으므로 숨긴다(data-js-only, BaseHead의 noscript 스타일).
---

<button type="button" class="theme-toggle" data-theme-toggle data-js-only aria-label="테마 전환">
  <!-- 다크일 때 보이는 해 아이콘: 누르면 라이트 -->
  <svg class="theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"></path>
  </svg>
  <!-- 라이트일 때 보이는 달 아이콘: 누르면 다크 -->
  <svg class="theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  // 버튼 이름: 지금 테마에서 누르면 바뀔 테마를 말한다
  function labelFor(isDark: boolean) {
    return isDark ? '라이트 테마로 전환' : '다크 테마로 전환';
  }

  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.setAttribute('aria-label', labelFor(root.classList.contains('dark')));
    button.addEventListener('click', () => {
      const isDark = !root.classList.contains('dark');
      root.classList.toggle('dark', isDark);
      root.classList.toggle('light', !isDark);
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // 저장할 수 없어도(사생활 보호 모드 등) 이 페이지의 테마는 바뀐다
      }
      button.setAttribute('aria-label', labelFor(isDark));
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-colors);
  }
  .theme-toggle:hover {
    color: var(--text-primary);
    background: var(--bg-card);
  }
  /* 다크(기본): 해 아이콘. 라이트: 달 아이콘 */
  .theme-icon-moon {
    display: none;
  }
  :global(html.light) .theme-icon-sun {
    display: none;
  }
  :global(html.light) .theme-icon-moon {
    display: block;
  }
</style>
