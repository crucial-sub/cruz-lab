---
// 공개 페이지 틀 (재건 4단계 D9·D10)
// - ClientRouter(ViewTransitions)를 지웠다. 페이지 이동은 보통 문서 이동이다.
//   문서 간 전환 페이드는 global.css의 @view-transition이 맡는다(지원 브라우저만).
// - 공개 페이지에는 React 아일랜드가 없다. 남은 클라이언트 스크립트는 테마 버튼, 목록 검색, 글 상세 보조뿐이다.
// - 페이지별 head 요소(예: 글 상세의 KaTeX CSS)는 head 슬롯이다(BaseHead 바로 뒤).
//   BaseHead에 자식으로 넘기거나 이 파일에 스타일 블록을 두면 astro-eslint-parser가 이 파일을 읽지 못한다.
//   그래서 슬롯은 PR-A의 자리 그대로 두고, 틀의 모양(.site, .site-main)은 global.css에 둔다.
import '../styles/global.css';
import BaseHead from './components/BaseHead.astro';
import Footer from './components/Footer.astro';
import Header from './components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  noindex?: boolean;
}

const { title, description, ogImage, type, publishedTime, tags, noindex } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <BaseHead {title} {description} {ogImage} {type} {publishedTime} {tags} {noindex} />
  <!-- 페이지별 head 요소(예: 글 상세의 KaTeX CSS, 4단계 D16). </head> 뒤라도 HTML 파서가 head에 넣는다 -->
  <slot name="head" />
  <body class="site">
    <!-- 건너뛰기 링크 (접근성) -->
    <a href="#main-content" class="skip-link">본문으로 건너뛰기</a>

    <Header />

    <main id="main-content" tabindex="-1" class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>

