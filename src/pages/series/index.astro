---
// 연재 목록 /series (재건 4단계 D6·D17, U15)
// - 연재 한 줄씩: 제목 · 설명 · N편 · 마지막 발행일. 이모지 제목은 없다.
// - 헤더 메뉴에는 없다(D6 답). 입구는 /blog의 "연재 N개 보기", 태그 칩, 글 상세 연재 상자, 푸터다.
// - 연재 데이터는 entries의 published.series로 모은다(2단계). 가장 최근에 글이 발행된 연재가 먼저다.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedSeriesList } from '@/lib/content-posts';
import { formatSeoulDate } from '@/lib/date-format';
import { seriesPath } from '@/lib/public-paths';
import { setPublicPageCache } from '@/lib/server/cache-headers';

export const prerender = false;

const seriesList = await getPublishedSeriesList();

// CDN이 60초 동안 이 응답을 저장하게 한다
setPublicPageCache(Astro.response.headers);

const title = '연재';
const description = '여러 편으로 이어지는 글 묶음';
---

<BaseLayout title={title} description={description}>
  <section class="series-index" aria-labelledby="series-index-title">
    <header class="series-index-head">
      <h1 id="series-index-title">{title}</h1>
      <p>{description}</p>
    </header>

    {
      seriesList.length === 0 ? (
        <p class="series-empty">
          아직 연재가 없습니다. <a href="/blog">모든 글 보기 →</a>
        </p>
      ) : (
        <ul class="series-list">
          {seriesList.map((series) => (
            <li class="series-item">
              <h2 class="series-item-title">
                <a href={seriesPath(series.key)}>{series.title}</a>
              </h2>
              {series.description && <p class="series-item-desc">{series.description}</p>}
              <p class="series-item-meta">
                <span>{series.posts.length}편</span>
                <span>
                  마지막 발행 <time datetime={series.updatedAt.toISOString()}>{formatSeoulDate(series.updatedAt)}</time>
                </span>
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .series-index {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .series-index-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h1 {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: var(--leading-heading);
  }
  .series-index-head p,
  .series-empty {
    margin: 0;
    color: var(--text-secondary);
  }
  .series-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .series-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.125rem 0.5rem;
    border-bottom: 1px solid var(--border);
    transition: var(--transition-colors);
  }
  .series-item:hover {
    background: var(--bg-surface);
  }
  .series-item-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--leading-heading);
  }
  .series-item-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .series-item-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .series-item-title a:focus-visible {
    outline: none;
  }
  /* 포커스 표시는 전체를 덮는 가상 요소에 그린다(:has()가 없는 브라우저에서도 보인다) */
  .series-item-title a:focus-visible::after {
    outline: 2px solid var(--ring-focus);
    outline-offset: 2px;
    border-radius: 0;
  }
  .series-item:hover .series-item-title a {
    color: var(--brand);
  }
  .series-item-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .series-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0.25rem 0 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
</style>
