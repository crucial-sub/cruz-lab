---
// 글 목록 /blog (재건 4단계 D2·D11·D17)
// - 발행 글 전체. 카테고리 탭 "전체"가 현재다.
// - 서버가 모든 행을 그린다. JS 없이도 목록 전체가 읽힌다. 검색은 행을 숨길 뿐이다(D2).
import BlogList from '@/components/blog/BlogList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedContentPosts, getPublishedSeriesList } from '@/lib/content-posts';
import { setPublicPageCache } from '@/lib/server/cache-headers';

export const prerender = false;

const [posts, seriesList] = await Promise.all([getPublishedContentPosts(), getPublishedSeriesList()]);

// CDN이 60초 동안 이 응답을 저장하게 한다
setPublicPageCache(Astro.response.headers);

const title = 'Blog';
const description = '개발하면서 배운 것과 겪은 것을 기록합니다.';
---

<BaseLayout title={title} description={description}>
  <BlogList
    title={title}
    description={description}
    allPosts={posts}
    posts={posts}
    seriesList={seriesList}
    currentCategory="all"
  />
</BaseLayout>
