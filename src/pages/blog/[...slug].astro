---
// 글 상세 /blog/<slug> (재건 4단계 D7·D11·D16)
// - 조회: findPublishedEntryBySlug(메모 60초). 예전 slug와 다른 kind(노트·프로젝트 글)의 slug는 그 주소로 301.
// - 본문: renderEntry(글 ID·발행본 번호로 메모리 캐시) → 공유 파이프라인(Shiki, 제목 id·목차, srcset).
// - KaTeX CSS는 본문에 수식이 있을 때만 넣는다(D16). 코드 하이라이트는 외부 CSS 없이 shiki.css다(cdnjs 링크 없음).
// - CDN: 글을 찾았을 때만 s-maxage=60, 태그 posts,post-<id>. 404는 저장하지 않는다.
import katexCssUrl from 'katex/dist/katex.min.css?url';
import PostArticle from '@/components/post/PostArticle.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getAdjacentPosts,
  getPublishedSeriesByKey,
  resolvePostPageBySlug,
} from '@/lib/content-posts';
import { POSTS_CACHE_TAG, postCacheTag, setPublicPageCache } from '@/lib/server/cache-headers';
import { renderEntry } from '@/lib/server/render-entry';

export const prerender = false;

const slug = Astro.params.slug || '';
const lookup = await resolvePostPageBySlug(slug);

// 예전 slug(slugHistory) 또는 다른 kind의 slug면 그 주소로 301
if (lookup?.type === 'redirect') {
  const response = Astro.redirect(lookup.location, 301);
  setPublicPageCache(response.headers, [POSTS_CACHE_TAG, postCacheTag(lookup.id)]);
  return response;
}

const entry = lookup?.type === 'post' ? lookup.entry : null;

const [rendered, adjacent, series] = entry
  ? await Promise.all([
      renderEntry(entry),
      getAdjacentPosts(entry.id),
      entry.series ? getPublishedSeriesByKey(entry.series.key) : Promise.resolve(null),
    ])
  : [null, null, null];

if (!entry) {
  Astro.response.status = 404;
  // 404 응답은 기본적으로 404.astro로 대체되므로, 아래의 글 전용 안내 화면이 그대로 나가도록 재라우팅을 끈다
  Astro.response.headers.set('X-Astro-Reroute', 'no');
} else {
  // 글을 찾은 경우에만 CDN 캐시를 건다. 404는 저장하지 않는다
  setPublicPageCache(Astro.response.headers, [POSTS_CACHE_TAG, postCacheTag(entry.id)]);
}

const title = entry?.title || '포스트를 찾을 수 없습니다';
const description = entry?.description || '요청한 블로그 포스트를 찾을 수 없습니다.';
// OG 이미지는 표지 이미지다. 4단계 PR-C(T7)가 /og/<id>.png로 바꾼다(D13)
const heroImage = entry?.cover.kind === 'image' ? entry.cover.url : undefined;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage}
  type="article"
  publishedTime={entry?.publishedAt.toISOString()}
  tags={entry?.tags ?? []}
>
  {rendered?.hasMath && <link slot="head" rel="stylesheet" href={katexCssUrl} />}
  {
    entry && rendered && adjacent ? (
      <PostArticle entry={entry} rendered={rendered} adjacent={adjacent} series={series} />
    ) : (
      <div class="py-20 text-center">
        <a
          href="/blog"
          class="group mb-8 inline-flex items-center gap-2 text-text-secondary transition-colors hover:text-brand"
        >
          <svg
            class="h-4 w-4 transition-transform group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          블로그로 돌아가기
        </a>
        <h1 class="text-3xl font-bold text-text-primary">포스트를 찾을 수 없습니다.</h1>
        <p class="mt-4 text-text-secondary">삭제되었거나 아직 발행되지 않은 글일 수 있습니다.</p>
      </div>
    )
  }
</BaseLayout>
