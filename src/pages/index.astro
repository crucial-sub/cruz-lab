---
// 홈 / (재건 4단계 D17, U1~U7)
// 위에서 아래 순서:
// 1. 이름 "Cruz" + 한 줄 + 2줄 소개 + "소개 →"(/about) · "프로젝트 →"(/projects). 사진은 없다.
// 2. 최신 글 3편(코드 커버 카드) + "모든 글 →"
// 3. 최신 노트 3편(날짜 + 첫 줄 120자) + "모든 노트 →". 노트가 없으면 이 구역을 숨긴다.
// - 3단계까지의 히어로 애니메이션·커서·경력 아코디언·스킬 그리드·연락처 구역은 지웠다. 경력·기술·연락처는 /about에 있다.
import PostCard from '@/components/blog/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedContentPosts, getPublishedNoteEntries } from '@/lib/content-posts';
import { firstLineExcerpt } from '@/lib/content/excerpt';
import { formatSeoulDate } from '@/lib/date-format';
import { notePath, SITE_TITLE } from '@/lib/public-paths';
import { setPublicPageCache } from '@/lib/server/cache-headers';

export const prerender = false;

const [posts, notes] = await Promise.all([getPublishedContentPosts(), getPublishedNoteEntries()]);
const recentPosts = posts.slice(0, 3);
const recentNotes = notes.slice(0, 3).map((note) => ({
  id: note.id,
  href: notePath(note.slug),
  date: note.publishedAt,
  // 제목이 있으면 제목, 없으면 본문 첫 줄
  line: note.title || firstLineExcerpt(note.markdown) || '노트',
}));

// CDN이 60초 동안 이 응답을 저장하게 한다
setPublicPageCache(Astro.response.headers);

const tagline = '사용자와 가장 가까운 곳에서 최적의 사용자 경험을 설계하는 개발자';
---

<BaseLayout title={SITE_TITLE} description={`Cruz — ${tagline}`}>
  <div class="home">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">Cruz</h1>
      <p class="home-tagline">{tagline}</p>
      <p class="home-lead">
        사용자 경험은 데이터가 전달되는 방식과 흐름에서 완성된다고 믿습니다.<br />
        WebSocket·SSE 스트리밍으로 긴 연산과 응답 지연을 풀었고, 크래프톤 정글에서 OS·네트워크 기초를 다졌습니다.
      </p>
      <p class="home-links">
        <a href="/about">소개 →</a>
        <a href="/projects">프로젝트 →</a>
      </p>
    </section>

    {
      recentPosts.length > 0 && (
        <section class="home-section" aria-labelledby="home-posts-title">
          <header class="home-section-head">
            <h2 id="home-posts-title">최신 글</h2>
            <a href="/blog">모든 글 →</a>
          </header>
          <ul class="home-cards">
            {recentPosts.map((post) => (
              <li>
                <PostCard post={post} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recentNotes.length > 0 && (
        <section class="home-section" aria-labelledby="home-notes-title">
          <header class="home-section-head">
            <h2 id="home-notes-title">최신 노트</h2>
            <a href="/notes">모든 노트 →</a>
          </header>
          <ul class="home-notes">
            {recentNotes.map((note) => (
              <li>
                <time datetime={note.date.toISOString()}>{formatSeoulDate(note.date)}</time>
                <a href={note.href}>{note.line}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .home-intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
  }
  h1 {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: var(--leading-heading);
  }
  .home-tagline {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.45;
    word-break: keep-all;
  }
  .home-lead {
    max-width: 44rem;
    margin: 0;
    color: var(--text-secondary);
    word-break: keep-all;
  }
  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0.25rem 0 0;
    font-weight: 600;
  }
  .home-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .home-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  h2 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-heading);
  }
  .home-section-head a {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .home-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-cards > li {
    display: flex;
  }
  .home-cards > li > :global(*) {
    flex: 1;
  }
  .home-notes {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .home-notes li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--border);
  }
  .home-notes time {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .home-notes a {
    overflow: hidden;
    color: var(--text-primary);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .home-notes a:hover {
    color: var(--brand);
  }
  @media (max-width: 479.98px) {
    .home-notes li {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
  }
</style>
