---
// 404 페이지 (재건 4단계 D10, U18)
// - 정적 파일로 미리 만든다(prerender). 서버 함수를 거치지 않는다(2단계 작업 문서 8절 3).
// - 내용은 NotFound.astro다. 없는 카테고리·태그·연재·노트 주소의 SSR 404도 같은 컴포넌트를 쓴다.
// - 검색 엔진에 싣지 않는다(noindex).
export const prerender = true;

import NotFound from '@/components/NotFound.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지를 찾을 수 없습니다." noindex>
  <NotFound />
</BaseLayout>
