---
// 프로젝트 글 /projects/<key>/<slug> (재건 4단계 D1·D16·D17, SSR)
// - 데이터: entries(kind project). 연재 key가 프로젝트 key다. 프로젝트 정보는 seriesMeta/<key>.project.
// - 글 상세와 같은 PostArticle(kind="project")이다: 목차·코드 복사·Shiki·제목 앵커를 함께 얻는다.
//   연재 상자 자리에 Part 탭, 글 끝에 이전·다음 Part.
// - 예전 slug, 다른 kind의 slug, 프로젝트를 옮긴 글은 바른 주소로 301(slug 공간이 하나다).
// - CDN: 글을 찾았을 때만 s-maxage=60, 태그 posts,post-<id>. 없으면 안내 화면을 직접 그리고(404) 저장하지 않는다.
import katexCssUrl from 'katex/dist/katex.min.css?url';
import NotFound from '@/components/NotFound.astro';
import PostArticle from '@/components/post/PostArticle.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getAdjacentParts,
  getPublishedProjectByKey,
  resolveProjectPageBySlug,
} from '@/lib/content-posts';
import { ogImagePath } from '@/lib/public-paths';
import { POSTS_CACHE_TAG, postCacheTag, setPublicPageCache } from '@/lib/server/cache-headers';
import { markNotFound } from '@/lib/server/not-found';
import { renderEntry } from '@/lib/server/render-entry';

export const prerender = false;

const projectKey = Astro.params.project ?? '';
const slug = Astro.params.slug ?? '';
const lookup = await resolveProjectPageBySlug(projectKey, slug);

if (lookup?.type === 'redirect') {
  const response = Astro.redirect(lookup.location, 301);
  setPublicPageCache(response.headers, [POSTS_CACHE_TAG, postCacheTag(lookup.id)]);
  return response;
}

const found = lookup?.type === 'post' ? lookup.entry : null;
const [rendered, project] = found
  ? await Promise.all([renderEntry(found), getPublishedProjectByKey(projectKey)])
  : [null, null];
// 프로젝트 정보(seriesMeta.project)가 없으면 프로젝트 글로 보이지 않는다(/projects 목록에도 없다)
const entry = found && project ? found : null;

if (entry) {
  setPublicPageCache(Astro.response.headers, [POSTS_CACHE_TAG, postCacheTag(entry.id)]);
} else {
  markNotFound(Astro.response);
}

const adjacent = entry && project ? getAdjacentParts(project, entry.id) : null;
const title =
  entry && project ? `${entry.title} | ${project.title}` : '프로젝트 글을 찾을 수 없습니다';
const description = entry?.description || '요청한 프로젝트 글을 찾을 수 없습니다.';
---

<BaseLayout
  title={title}
  description={description}
  ogImage={entry ? ogImagePath(entry.id) : undefined}
  type={entry ? 'article' : 'website'}
  publishedTime={entry?.publishedAt.toISOString()}
  tags={project?.meta.tags ?? []}
  noindex={!entry}
>
  {rendered?.hasMath && <link slot="head" rel="stylesheet" href={katexCssUrl} />}
  {
    entry && rendered && adjacent && project ? (
      <PostArticle
        entry={entry}
        rendered={rendered}
        adjacent={adjacent}
        series={null}
        kind="project"
        project={project}
      />
    ) : (
      <NotFound
        title="프로젝트 글을 찾을 수 없습니다"
        message="삭제되었거나 아직 발행되지 않은 글일 수 있습니다."
      />
    )
  }
</BaseLayout>
