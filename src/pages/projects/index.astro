---
// 프로젝트 목록 /projects (재건 4단계 D1·D17, SSR)
// - 데이터: entries(kind project) + seriesMeta/<key>.project. 발행된 Part가 있는 프로젝트만 보인다.
// - 프로젝트를 project.order 순으로 카드(코드 커버)로 보인다. featured 구분은 없다(4개 모두 featured다, D17).
// - 카드를 누르면 그 프로젝트의 첫 Part로 간다.
// - CDN: s-maxage=60, 태그 posts(발행하면 목록 무효화로 함께 비워진다).
import ProjectCard from '@/components/projects/ProjectCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedProjects } from '@/lib/content-posts';
import { projectPostPath } from '@/lib/public-paths';
import { setPublicPageCache } from '@/lib/server/cache-headers';

export const prerender = false;

const title = 'Projects';
const description = 'Cruz의 프로젝트와 그 과정의 기록';

const projects = await getPublishedProjects();
setPublicPageCache(Astro.response.headers);

// 커버 왼쪽 위 날짜: 시작 월(YYYY-MM). 없으면 첫 Part의 발행일
function coverDateOf(project: (typeof projects)[number]): Date {
  const month = project.meta.startDate;
  if (month) {
    const [year, monthIndex] = month.split('-').map(Number);
    return new Date(Date.UTC(year, monthIndex - 1, 1));
  }
  return project.posts[0].pubDate;
}
---

<BaseLayout title={title} description={description}>
  <section class="projects" aria-labelledby="projects-title">
    <header class="projects-head">
      <h1 id="projects-title">{title}</h1>
      <p>{description}</p>
    </header>
    {
      projects.length === 0 ? (
        <p class="projects-empty">아직 등록된 프로젝트가 없습니다.</p>
      ) : (
        <ul class="projects-grid">
          {projects.map((project) => (
            <li>
              <ProjectCard
                title={project.title}
                description={project.description}
                href={projectPostPath(project.key, project.posts[0].slug)}
                tech={project.meta.tech}
                coverKey={project.key}
                coverDate={coverDateOf(project)}
                github={project.meta.github}
                demo={project.meta.demo}
              />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .projects-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h1 {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: var(--leading-heading);
  }
  .projects-head p,
  .projects-empty {
    margin: 0;
    color: var(--text-secondary);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects-grid > li {
    display: flex;
  }
  .projects-grid > li > :global(*) {
    flex: 1;
  }
</style>
