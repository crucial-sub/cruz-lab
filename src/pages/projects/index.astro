---
// 프로젝트 목록 /projects (prerender, 콘텐츠 컬렉션)
// - 프로젝트 4개를 order 순으로 카드(코드 커버)로 보인다. featured 구분은 없다(4개 모두 featured다, D17).
// - 4단계 PR-B: React 아일랜드(ProjectCard.tsx)와 Reveal을 ProjectCard.astro로 바꿨다. 데이터는 그대로다.
//   4단계 PR-C(T6)가 데이터를 entries(seriesMeta.project)로 옮긴다(D1).
export const prerender = true;

import ProjectCard from '@/components/projects/ProjectCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjectHref, getProjectMetas, getProjectSlug } from '@/lib/project-posts';
import { getCollection } from 'astro:content';

const title = 'Projects';
const description = 'Cruz의 프로젝트와 그 과정의 기록';

const entries = await getCollection('projects');
// getProjectMetas가 order 순으로 정렬한다
const projects = getProjectMetas(entries);
---

<BaseLayout title={title} description={description}>
  <section class="projects" aria-labelledby="projects-title">
    <header class="projects-head">
      <h1 id="projects-title">{title}</h1>
      <p>{description}</p>
    </header>
    {
      projects.length === 0 ? (
        <p class="projects-empty">아직 등록된 프로젝트가 없습니다.</p>
      ) : (
        <ul class="projects-grid">
          {projects.map((project) => {
            const key = getProjectSlug(project);
            return (
              <li>
                <ProjectCard
                  title={project.data.title}
                  description={project.data.description}
                  href={getProjectHref(entries, key)}
                  tech={project.data.tech}
                  coverKey={key}
                  coverDate={project.data.startDate ?? new Date()}
                  github={project.data.github}
                  demo={project.data.demo}
                />
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .projects-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h1 {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: var(--leading-heading);
  }
  .projects-head p,
  .projects-empty {
    margin: 0;
    color: var(--text-secondary);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects-grid > li {
    display: flex;
  }
  .projects-grid > li > :global(*) {
    flex: 1;
  }
</style>
