---
// 에디터 페이지 (재건 3단계 T3, D13)
// - 관리자 페이지는 모두 SSR이다. 미들웨어가 세션 쿠키를 검사한다(2단계 D5).
// - 사이트 헤더·푸터 없이 전체 화면이다. 틀(테마 초기화 포함)은 AdminPage.astro다(M10).
// - 에디터 코드는 이 페이지에서만 내려받는다(client:only). KaTeX CSS도 이 페이지에만 넣는다(D3 수식).
// - 글 데이터는 클라이언트가 GET /api/admin/posts/{id}로 읽는다. 404면 목록으로 간다(Plan 5절).
export const prerender = false;

import EditorApp from '@/editor/ui/EditorApp';
import AdminPage from '@/layouts/AdminPage.astro';
import 'katex/dist/katex.min.css';
import '@/editor/editor.css';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin');
---

<AdminPage title="글 편집 | Cruz Lab">
  <EditorApp client:only="react" entryId={id} />
</AdminPage>
