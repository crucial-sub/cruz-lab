---
// 서가 문서 주소 /admin/library/d/{문서 id} (서가 1단계 Plan J7·J12·J14)
// - 목록의 제목 링크, QR 코드, 북마크가 이 주소를 쓴다. 문서 출처 주소와 달리 언제나 통한다.
// - 미들웨어가 관리자 세션을 검사한다. 로그아웃이면 로그인 화면으로 보낸다(J3). 서가가 꺼져 있으면 404(C5).
// - md 판이 있으면 md 뷰어다(T7). md·html 짝이어도 글(md)이 기본이고, ?v=html이면 그림(html)으로 간다
//   (사용자 결정 2026-11-18, 안 A).
// - html 판만 있거나 ?v=html이면: 입장권을 만들고 읽음을 표시한 뒤 문서 출처로 302(J6 독립 페이지).
// - 없는 문서: 404 화면과 "서가로 돌아가기". md 파일을 읽지 못하면 500 화면.
// - 서가 2단계 J31: md 링크로 온 없는 문서면 주소의 ref(원래 링크 글)·from(앞 문서)으로 무엇이 없는지와 "← 앞 문서"를 보인다.
export const prerender = false;

import AdminPage from '@/layouts/AdminPage.astro';
import { markNotFound } from '@/lib/server/not-found';
import { libraryEnabled, libraryShareEnabled } from '@/library/server/api';
import { readLinkNotice } from '@/library/links';
import { createDocOpenDeps, DOC_VIEW_PARAM, resolveDocOpen, type DocOpenResult } from '@/library/server/open';
import { libraryOffResponse, rawMisconfiguredResponse } from '@/library/server/raw';
import { loadLibraryMarkdownView, type LibraryMarkdownView } from '@/library/server/render-md';
import LibraryHead from '@/library/ui/LibraryHead.astro';
import MdView from '@/library/ui/MdView.astro';
import MissingView from '@/library/ui/MissingView.astro';
import ShareDialog from '@/library/ui/ShareDialog.astro';

// 미들웨어 판정이 빗나가도 이 페이지가 혼자 열리지 않게 한 번 더 본다
if (!libraryEnabled()) return libraryOffResponse();

let result: DocOpenResult;
try {
  result = await resolveDocOpen(
    Astro.params.id,
    createDocOpenDeps(Astro.url),
    Astro.url.searchParams.get(DOC_VIEW_PARAM),
  );
} catch (error) {
  console.error('[library] 서가 문서 열기 실패', error);
  return rawMisconfiguredResponse();
}

if (result.kind === 'redirect') return Astro.redirect(result.location, 302);

let view: LibraryMarkdownView | null = null;
if (result.kind === 'md') {
  try {
    view = await loadLibraryMarkdownView(Astro.params.id as string, result.doc.key, result.md, result.docOrigin);
  } catch (error) {
    console.error(`[library] md 문서 읽기 실패: ${Astro.params.id}`, error);
    Astro.response.status = 500;
    // 배포 환경 Astro가 500을 블로그 오류 화면으로 바꿔 그리지 않게 한다(이 페이지가 안내를 그린다)
    Astro.response.headers.set('X-Astro-Reroute', 'no');
  }
} else {
  // 404도 블로그 404 화면으로 바꿔 그리지 않게 한다. 바꿔 그리면 링크 글·"← 앞 문서" 안내가 사라진다(2단계 J31)
  markNotFound(Astro.response);
}

const md = result.kind === 'md' ? result : null;
const notice = readLinkNotice(Astro.url.searchParams);
const pageTitle = md ? `${md.doc.title} | 서가` : '문서 없음 | 서가';
// 공유 단추와 공유 창 (서가 2단계 J51). 공유 스위치가 꺼져 있으면 그리지 않는다
const shareEnabled = libraryShareEnabled();
---

<AdminPage title={pageTitle}>
  <LibraryHead slot="head" />
  {
    md && view ? (
      <MdView
        docId={Astro.params.id as string}
        doc={md.doc}
        view={view}
        hasHtml={md.hasHtml}
        ticketPixelUrl={md.ticketPixelUrl}
        shareEnabled={shareEnabled}
      />
    ) : md ? (
      <MissingView heading={md.doc.title}>
        <p>md 문서를 읽지 못했습니다. 잠시 뒤 다시 열어 주세요.</p>
      </MissingView>
    ) : (
      <MissingView heading="서가에 없는 문서입니다" from={notice.from}>
        {notice.ref ? (
          <p>
            링크한 문서 <code class="rounded bg-bg-card px-1 py-0.5 text-text-primary">{notice.ref}</code>는 서가에
            없습니다. 맥에서 올리면 이 링크가 열립니다.
          </p>
        ) : (
          <p>주소가 틀렸거나 서가에서 내린 문서입니다.</p>
        )}
      </MissingView>
    )
  }
  {md && view && shareEnabled && <ShareDialog />}
</AdminPage>
