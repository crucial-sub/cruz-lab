---
// 판에 없는 파일 안내 /admin/library/missing?from={앞 문서 id}&ref={원래 링크 글} (서가 2단계 Plan J32)
// - md 뷰어의 링크 중 서가에서 열 수 없는 것이 여기로 온다(links.ts):
//   이 판에 없는 파일(csv·txt 등. md를 맥에서 올리면 그림만 함께 올라간다), 서가 밖(홈·프로젝트 위, 절대 경로)을 가리키는 문서 링크.
// - 미들웨어가 관리자 세션을 검사한다(로그아웃이면 로그인 화면). 서가가 꺼져 있으면 404.
// - 응답 상태는 404다(X-Astro-Reroute: no로 이 안내를 그대로 보낸다). 링크 글은 화면에 글자로만 보인다(Astro가 이스케이프한다).
export const prerender = false;

import AdminPage from '@/layouts/AdminPage.astro';
import { markNotFound } from '@/lib/server/not-found';
import { readLinkNotice } from '@/library/links';
import { libraryEnabled } from '@/library/server/api';
import { libraryOffResponse } from '@/library/server/raw';
import LibraryHead from '@/library/ui/LibraryHead.astro';
import MissingView from '@/library/ui/MissingView.astro';

// 미들웨어 판정이 빗나가도 이 페이지가 혼자 열리지 않게 한 번 더 본다
if (!libraryEnabled()) return libraryOffResponse();

const notice = readLinkNotice(Astro.url.searchParams);
// 상태는 404, 안내는 이 페이지가 그린다(배포 환경 Astro가 블로그 404 화면으로 바꿔 그리지 않게 한다)
markNotFound(Astro.response);
---

<AdminPage title="열 수 없는 링크 | 서가">
  <LibraryHead slot="head" />
  <MissingView heading="서가에서 열 수 없는 링크입니다" from={notice.from}>
    {
      notice.ref ? (
        <p>
          링크한 주소 <code class="rounded bg-bg-card px-1 py-0.5 text-text-primary">{notice.ref}</code>는 이 문서와
          함께 서가에 올라가지 않은 파일이거나, 서가 밖을 가리키는 주소입니다.
        </p>
      ) : (
        <p>이 문서와 함께 서가에 올라가지 않은 파일이거나, 서가 밖을 가리키는 주소입니다.</p>
      )
    }
  </MissingView>
</AdminPage>
