---
// 새 글 만들기 (재건 3단계 D2 a, T7의 일부를 PR-B에서 앞당김)
// - 서버에서 빈 초안을 만들고(POST /api/admin/posts와 같은 createEntry) 새 글의 에디터 주소로 302한다.
// - ?kind=note면 노트다. 그 밖은 글(post)이다.
// - 옛 EditorPage(CodeMirror)는 PR-B가 지웠다. 최소 목록 /admin은 PR-C(T7)가 만든다.
export const prerender = false;

import { CREATABLE_KINDS } from '@/lib/entry-rules';
import { createEntry } from '@/lib/server/admin-entries';

const requested = Astro.url.searchParams.get('kind');
const kind = (CREATABLE_KINDS as readonly string[]).includes(requested ?? '')
  ? (requested as (typeof CREATABLE_KINDS)[number])
  : 'post';

const created = await createEntry(kind);
return Astro.redirect(`/admin/edit/${created.id}`, 302);
---
