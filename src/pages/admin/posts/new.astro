---
// 새 글 만들기 (재건 3단계 D2 a, T7)
// - POST 폼만 받는다(사용자 결정 2026-11-09, 작업 문서 8절 3). GET은 /admin으로 보낸다.
//   세션 쿠키가 SameSite=Lax라 다른 사이트의 링크(GET)로는 빈 초안이 생기지 않는다. 쓰기 요청은 Origin도 같아야 한다.
// - 서버에서 빈 초안을 만들고(POST /api/admin/posts와 같은 createEntry) 새 글의 에디터 주소로 303한다.
// - kind=note면 노트다. 그 밖은 글(post)이다. 최소 목록 /admin의 "새 글"·"새 노트" 폼이 이 주소다.
export const prerender = false;

import { isSameOrigin } from '@/lib/admin-guard';
import { CREATABLE_KINDS } from '@/lib/entry-rules';
import { createEntry } from '@/lib/server/admin-entries';

if (Astro.request.method !== 'POST') return Astro.redirect('/admin', 302);
if (!isSameOrigin(Astro.request.headers.get('origin'), Astro.request.url)) {
  return new Response('요청 출처가 이 사이트가 아닙니다.', { status: 403 });
}

const form = await Astro.request.formData();
const requested = form.get('kind');
const kind = (CREATABLE_KINDS as readonly string[]).includes(String(requested ?? ''))
  ? (requested as (typeof CREATABLE_KINDS)[number])
  : 'post';

const created = await createEntry(kind);
return Astro.redirect(`/admin/edit/${created.id}`, 303);
---
