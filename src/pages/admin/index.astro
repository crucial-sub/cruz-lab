---
// 최소 관리자 목록 (재건 3단계 D2 a, T7)
// - 서버 렌더 한 장. React를 쓰지 않는다. 5단계가 관리자 앱으로 다시 만든다.
// - 상태 탭(전체·초안·발행·숨김과 수), 제목, 종류, 상태, 발행 뒤 변경, 수정일, 에디터 링크.
// - "새 글"·"새 노트"는 POST 폼이다. /admin/posts/new가 빈 초안을 만들고 에디터로 보낸다(GET으로는 만들지 않는다). 로그아웃은 세션 API를 부른다.
// - 미들웨어가 세션 쿠키를 검사한다. 응답은 저장하지 않는다(no-store).
export const prerender = false;

import AdminPage from '@/layouts/AdminPage.astro';
import { ENTRY_STATUSES, type EntryKind, type EntryStatus } from '@/lib/entry-schema';
import { listEntriesForAdmin } from '@/lib/server/admin-entries';

const STATUS_LABELS: Record<EntryStatus, string> = {
  draft: '초안',
  published: '발행됨',
  hidden: '숨김',
};
const KIND_LABELS: Record<EntryKind, string> = { post: '글', note: '노트', project: '프로젝트' };

const requested = Astro.url.searchParams.get('status');
const status = (ENTRY_STATUSES as readonly string[]).includes(requested ?? '')
  ? (requested as EntryStatus)
  : null;
const { counts, items } = await listEntriesForAdmin({ status, kind: null, q: null });
const total = counts.draft + counts.published + counts.hidden;

// 수정일은 서울 시각으로 보인다
const formatDate = (iso: string | null) =>
  iso
    ? new Intl.DateTimeFormat('ko-KR', {
        timeZone: 'Asia/Seoul',
        dateStyle: 'medium',
        timeStyle: 'short',
      }).format(new Date(iso))
    : '—';

const tabs: Array<{ key: EntryStatus | null; label: string; count: number }> = [
  { key: null, label: '전체', count: total },
  ...ENTRY_STATUSES.map((key) => ({ key, label: STATUS_LABELS[key], count: counts[key] })),
];
---

<AdminPage title="관리자 | Cruz Lab">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <header class="flex flex-wrap items-center gap-2">
      <h1 class="mr-auto text-xl font-bold">Cruz Lab 관리자</h1>
      <form method="post" action="/admin/posts/new">
        <input type="hidden" name="kind" value="post" />
        <button
          type="submit"
          class="rounded-md bg-brand px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-hover"
          >새 글</button
        >
      </form>
      <form method="post" action="/admin/posts/new">
        <input type="hidden" name="kind" value="note" />
        <button
          type="submit"
          class="rounded-md border border-border px-3 py-1.5 text-sm hover:bg-bg-card"
          >새 노트</button
        >
      </form>
      <button
        type="button"
        id="admin-logout"
        class="rounded-md px-3 py-1.5 text-sm text-text-secondary hover:text-text-primary"
        >로그아웃</button
      >
    </header>

    <nav class="mt-6 flex flex-wrap gap-1 border-b border-border text-sm" aria-label="상태">
      {
        tabs.map((tab) => (
          <a
            href={tab.key ? `/admin?status=${tab.key}` : '/admin'}
            class:list={[
              '-mb-px border-b-2 px-3 py-2',
              tab.key === status
                ? 'border-brand text-text-primary'
                : 'border-transparent text-text-secondary hover:text-text-primary',
            ]}
            aria-current={tab.key === status ? 'page' : undefined}
          >
            {tab.label} {tab.count}
          </a>
        ))
      }
    </nav>

    {
      items.length === 0 ? (
        <p class="py-10 text-center text-sm text-text-secondary">글이 없습니다.</p>
      ) : (
        <ul class="divide-y divide-border">
          {items.map((item) => (
            <li>
              <a
                href={`/admin/edit/${item.id}`}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-1 py-3 hover:bg-bg-card"
              >
                <span class="min-w-0 flex-1 truncate font-medium">
                  {item.title || '(제목 없음)'}
                </span>
                <span class="text-xs text-text-secondary">{KIND_LABELS[item.kind]}</span>
                <span class="text-xs text-text-secondary">{STATUS_LABELS[item.status]}</span>
                {item.hasUnpublishedChanges && (
                  <span class="text-xs text-amber-400">발행 뒤 변경 있음</span>
                )}
                <time class="text-xs text-text-secondary" datetime={item.updatedAt ?? undefined}>
                  {formatDate(item.updatedAt)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</AdminPage>

<script>
  // 로그아웃: 세션 쿠키를 지우고 로그인 화면으로 간다(DELETE /api/admin/session, 같은 origin)
  document.getElementById('admin-logout')?.addEventListener('click', async () => {
    try {
      await fetch('/api/admin/session', { method: 'DELETE' });
    } finally {
      window.location.assign('/admin/login');
    }
  });
</script>
