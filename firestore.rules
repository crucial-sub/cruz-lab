rules_version = '2';

// 클라이언트 SDK 접근 규칙
// - 모든 쓰기는 서버(Admin SDK)가 한다. Admin SDK는 이 규칙을 적용받지 않는다.
// - 따라서 클라이언트 쓰기는 전부 막고, 읽기는 공개 문서만 허용한다.
service cloud.firestore {
  match /databases/{database}/documents {
    // 시리즈: 공개 시리즈만 읽기 허용
    // - src/lib/series.ts가 isPublic == true 조건으로 쿼리한다.
    match /series/{seriesId} {
      allow read: if resource.data.isPublic == true;
      allow write: if false;
    }

    // 포스트: 공개되고 발행된 글만 읽기 허용
    // - 쿼리도 이 조건을 만족해야 한다(조건 없는 list는 거부된다).
    match /posts/{postId} {
      allow read: if resource.data.isPublic == true
        && resource.data.status == 'published';
      allow write: if false;
    }

    // 댓글: 사용하지 않는다. 전부 거부
    match /comments/{commentId} {
      allow read, write: if false;
    }
  }
}
