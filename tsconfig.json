{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // tools/raycast-cruz-lab: Raycast 확장. 자체 package.json·tsconfig로 검사한다(npm run typecheck)
  "exclude": ["dist", "tools/raycast-cruz-lab"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
      // "@content/*": ["src/content/*"]
    }
  }
}
